{
  "name": "free-games-bot",
  "version": "2.4.4",
  "description": "Free games bot for discord",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "docker-run": "docker run --rm --name free-games-bot -it -v $(pwd)/conf:/app/conf:rw fbrossar25/free-games-bot:$npm_package_version",
    "docker-run-dev": "docker run --rm --name free-games-bot-dev -it -v $(pwd)/conf:/app/conf:rw fbrossar25/free-games-bot:dev",
    "docker-bash": "docker run --rm --name free-games-bot -it -v $(pwd)/conf:/app/conf:rw -exec fbrossar25/free-games-bot:$npm_package_version /bin/sh",
    "docker-build-dev": "docker build -f dev.Dockerfile -t fbrossar25/free-games-bot:dev .",
    "docker-build": "docker build -f Dockerfile -t fbrossar25/free-games-bot:latest -t fbrossar25/free-games-bot:$npm_package_version .",
    "docker-push": "docker push fbrossar25/free-games-bot:$npm_package_version && docker push fbrossar25/free-games-bot:latest",
    "start": "TZ=Europe/Paris CONF_DIR=$(pwd)/conf node src/index.ts",
    "start:dev": "DEV=1 TZ=Europe/Paris CONF_DIR=$(pwd)/conf node src/index.ts",
    "start:win": "powershell ./start.ps1",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fbrossar25/Free-Games-Bot.git"
  },
  "keywords": [
    "discord",
    "bot",
    "free",
    "games"
  ],
  "author": "Florian BROSSARD",
  "license": "Unlicense",
  "bugs": {
    "url": "https://github.com/fbrossar25/Free-Games-Bot/issues"
  },
  "homepage": "https://github.com/fbrossar25/Free-Games-Bot#readme",
  "dependencies": {
    "@types/node": "^26.6.5",
    "@types/node-schedule": "^2.1.8",
    "axios": "^1.20.0",
    "bufferutil": "^4.1.0",
    "dayjs": "^1.11.23",
    "discord.js": "^14.27.0",
    "erlpack": "^0.1.4",
    "exit-hook": "^5.1.0",
    "node-schedule": "^2.1.1",
    "utf-8-validate": "^6.0.6",
    "zlib-sync": "^0.1.10"
  },
  "engines": {
    "npm": ">=11.0.0",
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
